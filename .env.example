# SiteLens AI Environment Variables
# Local Ollama AI Provider Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3:8b
OLLAMA_REQUEST_TIMEOUT_MS=60000

# Server-Side Crawler Configuration
CRAWLER_MAX_CONCURRENCY=2
CRAWLER_TIMEOUT_MS=30000
CRAWLER_USER_AGENT=SiteLens-Bot/1.0 (+https://github.com/sitelens/bot)

# Audit Storage & Reports Directory
STORAGE_DATA_DIR=./data/reports
